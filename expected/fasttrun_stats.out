--
-- fasttrun_stats — статистика по колонкам, локальная для сессии
-- (через get_relation_stats_hook), без записи в pg_statistic.
--
-- ВАЖНО: собранная статистика переживает commit и живёт до конца сеанса.
-- Транзакционный callback на commit снимает только привязку к счётчикам
-- транзакции, а на abort откатывает изменения этой транзакции. В BEGIN/COMMIT
-- обёрнуты те секции, где важна граница транзакции сама по себе.
--
/*
 * Поколоночный учёт UPDATE работает только там, где библиотека предзагружена:
 * иначе операторы, начавшиеся до её загрузки, остались невидимыми, и учёт
 * выключается на весь сеанс. Набор поднимает предзагрузку для своей базы и
 * переподключается, а в конце возвращает всё как было.
 */
ALTER DATABASE :DBNAME SET session_preload_libraries = 'fasttrun';
\connect -
CREATE EXTENSION fasttrun;
-- Узкая высокоселективная временная таблица с btree-индексом.
-- Без статистики по колонкам планировщик берёт DEFAULT_EQ_SEL=0.005
-- и выбирает Bitmap Heap Scan.  С нашей статистикой (n_distinct ~
-- reltuples, потому что id уникален) eq_sel = 1/N и план становится
-- Index Scan.
CREATE TEMP TABLE t_stats (id int, payload text);
INSERT INTO t_stats SELECT g, 'data_' || g FROM generate_series(1, 100000) g;
CREATE INDEX ON t_stats (id);
-- ----------------------------------------------------------------------
-- 1. auto_collect_stats=off + ручной вызов fasttrun_collect_stats
--    внутри одной транзакции: до сбора — Bitmap Heap Scan, после —
--    Index Scan
-- ----------------------------------------------------------------------
BEGIN;
SET LOCAL fasttrun.auto_collect_stats = off;
SELECT fasttrun_analyze('t_stats');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_stats WHERE id = 12345;
                QUERY PLAN                 
-------------------------------------------
 Bitmap Heap Scan on t_stats
   Recheck Cond: (id = 12345)
   ->  Bitmap Index Scan on t_stats_id_idx
         Index Cond: (id = 12345)
(4 rows)

SELECT fasttrun_collect_stats('t_stats');
 fasttrun_collect_stats 
------------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_stats WHERE id = 12345;
                 QUERY PLAN                 
--------------------------------------------
 Index Scan using t_stats_id_idx on t_stats
   Index Cond: (id = 12345)
(2 rows)

COMMIT;
-- ----------------------------------------------------------------------
-- 2. После COMMIT session-local stats остаются видимыми до DML/DDL.
--    Это ближе к обычному ANALYZE: планы в следующей транзакции не
--    деградируют только из-за границы транзакции.
-- ----------------------------------------------------------------------
EXPLAIN (COSTS OFF) SELECT * FROM t_stats WHERE id = 12345;
                 QUERY PLAN                 
--------------------------------------------
 Index Scan using t_stats_id_idx on t_stats
   Index Cond: (id = 12345)
(2 rows)

-- ----------------------------------------------------------------------
-- 3. auto_collect_stats=on (значение по умолчанию): fasttrun_analyze
--    собирает статистику автоматически на первом полном проходе,
--    отдельный вызов collect_stats не нужен
-- ----------------------------------------------------------------------
BEGIN;
SELECT fasttrun_analyze('t_stats');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_stats WHERE id = 12345;
                 QUERY PLAN                 
--------------------------------------------
 Index Scan using t_stats_id_idx on t_stats
   Index Cond: (id = 12345)
(2 rows)

COMMIT;
-- ----------------------------------------------------------------------
-- 4. fasttrun.sample_rows=0 отключает сбор даже при auto_collect=on
-- ----------------------------------------------------------------------
BEGIN;
SET LOCAL fasttrun.sample_rows = 0;
SELECT fasttrun_analyze('t_stats');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_stats WHERE id = 12345;
                 QUERY PLAN                 
--------------------------------------------
 Index Scan using t_stats_id_idx on t_stats
   Index Cond: (id = 12345)
(2 rows)

COMMIT;
-- ----------------------------------------------------------------------
-- 5. Многоколоночная таблица: автосбор статистики для всех колонок
-- ----------------------------------------------------------------------
CREATE TEMP TABLE t_multi (
    id int,
    user_id int,
    flag bool,
    payload text
);
INSERT INTO t_multi
SELECT g, g % 1000, g % 2 = 0, 'd_' || g
FROM generate_series(1, 50000) g;
CREATE INDEX ON t_multi (id);
CREATE INDEX ON t_multi (user_id);
BEGIN;
SELECT fasttrun_analyze('t_multi');
 fasttrun_analyze 
------------------
 
(1 row)

-- Equality по user_id (1000 уникальных значений, ~50 строк на каждое):
-- по умолчанию выбрался бы Bitmap, со статистикой — тоже Bitmap, но
-- более точная оценка стоимости; форма плана может не меняться
EXPLAIN (COSTS OFF) SELECT * FROM t_multi WHERE id = 12345;
                 QUERY PLAN                 
--------------------------------------------
 Index Scan using t_multi_id_idx on t_multi
   Index Cond: (id = 12345)
(2 rows)

EXPLAIN (COSTS OFF) SELECT * FROM t_multi WHERE user_id = 42;
                   QUERY PLAN                   
------------------------------------------------
 Bitmap Heap Scan on t_multi
   Recheck Cond: (user_id = 42)
   ->  Bitmap Index Scan on t_multi_user_id_idx
         Index Cond: (user_id = 42)
(4 rows)

COMMIT;
-- ----------------------------------------------------------------------
-- 6. Молчаливое игнорирование отсутствующей таблицы — функция
--    ничего не делает, ошибки нет
-- ----------------------------------------------------------------------
SELECT fasttrun_collect_stats('nonexistent_temp_xyz');
 fasttrun_collect_stats 
------------------------
 
(1 row)

-- ----------------------------------------------------------------------
-- 7. Ошибка на обычной (не временной) таблице
-- ----------------------------------------------------------------------
CREATE TABLE t_stats_persist (a int);
INSERT INTO t_stats_persist VALUES (1);
SELECT fasttrun_collect_stats('t_stats_persist');
ERROR:  fasttrun_collect_stats: relation "t_stats_persist" is not a local temporary table
-- Соединение продолжает работать
SELECT 1 AS still_alive;
 still_alive 
-------------
           1
(1 row)

-- ----------------------------------------------------------------------
-- 8. Устаревшая статистика после UPDATE, меняющего распределение.
--    Хук должен заметить, что pgstat-счётчики изменились
--    (tuples_updated), и НЕ отдавать кешированный n_distinct, иначе
--    планировщик оставит план, рассчитанный на старое распределение.
-- ----------------------------------------------------------------------
CREATE TEMP TABLE t_stale (id int, grp int);
INSERT INTO t_stale SELECT g, g FROM generate_series(1, 100000) g;
CREATE INDEX ON t_stale (grp);
BEGIN;
SELECT fasttrun_collect_stats('t_stale');
 fasttrun_collect_stats 
------------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_stale WHERE grp = 1;
                 QUERY PLAN                  
---------------------------------------------
 Index Scan using t_stale_grp_idx on t_stale
   Index Cond: (grp = 1)
(2 rows)

UPDATE t_stale SET grp = 1;
EXPLAIN (COSTS OFF) SELECT * FROM t_stale WHERE grp = 1;
                 QUERY PLAN                 
--------------------------------------------
 Bitmap Heap Scan on t_stale
   Recheck Cond: (grp = 1)
   ->  Bitmap Index Scan on t_stale_grp_idx
         Index Cond: (grp = 1)
(4 rows)

COMMIT;
DROP TABLE t_stale;
-- ----------------------------------------------------------------------
-- 8b. После сброса локальной статистики планировщик не должен читать
--     старые значения остальных колонок из pg_statistic.
-- ----------------------------------------------------------------------
CREATE TEMP TABLE t_policy_default (id int, grp int);
INSERT INTO t_policy_default SELECT g, 1 FROM generate_series(1, 10000) g;
ANALYZE t_policy_default;
SELECT fasttruncate('t_policy_default');
 fasttruncate 
--------------
 
(1 row)

INSERT INTO t_policy_default SELECT g, g FROM generate_series(1, 10000) g;
SET fasttrun.auto_collect_stats = off;
SELECT fasttrun_analyze('t_policy_default');
 fasttrun_analyze 
------------------
 
(1 row)

DO $$
DECLARE ln text; est int := NULL;
BEGIN
  FOR ln IN EXPLAIN SELECT * FROM t_policy_default WHERE grp = 1 LOOP
    IF ln ~ 'on t_policy_default' THEN
      est := substring(ln FROM 'rows=(\d+)')::int;
      EXIT;
    END IF;
  END LOOP;
  IF est IS NULL OR est < 20 OR est > 100 THEN
    RAISE EXCEPTION 'stale core stats escaped neutral policy: est=%', est;
  END IF;
END$$;
SELECT 'relation_policy_blocks_core' AS marker;
           marker            
-----------------------------
 relation_policy_blocks_core
(1 row)

RESET fasttrun.auto_collect_stats;
DROP TABLE t_policy_default;
-- ----------------------------------------------------------------------
-- 8c. Скрытая статистика должна безопасно работать и с BRIN.
--     BRIN передаёт хуку неинициализированный VariableStatData, поэтому
--     ветка без локального statsTuple обязана явно вернуть NULL.
-- ----------------------------------------------------------------------
DO $$
DECLARE ln text;
BEGIN
  EXECUTE 'CREATE TEMP TABLE t_brin_hidden_stats (id int, grp int)';
  EXECUTE 'INSERT INTO t_brin_hidden_stats SELECT g, g FROM generate_series(1, 100000) g';
  EXECUTE 'CREATE INDEX ON t_brin_hidden_stats USING brin (grp)';
  EXECUTE 'ANALYZE t_brin_hidden_stats';
  PERFORM fasttruncate('t_brin_hidden_stats');
  EXECUTE 'INSERT INTO t_brin_hidden_stats SELECT g, g FROM generate_series(1, 10000) g';
  PERFORM set_config('enable_seqscan', 'off', true);
  FOR ln IN EXECUTE
      'EXPLAIN (COSTS OFF) SELECT * FROM t_brin_hidden_stats WHERE grp BETWEEN 10 AND 20'
  LOOP
    NULL;
  END LOOP;
END$$;
\echo brin_hidden_stats_safe
brin_hidden_stats_safe
DROP TABLE t_brin_hidden_stats;
-- ----------------------------------------------------------------------
-- 8d. DDL нетронутой таблицы не должен скрывать её ядерную статистику,
--     даже если кэши fasttrun уже созданы для другой таблицы.
-- ----------------------------------------------------------------------
DO $$
DECLARE ln text; est int; stat_count int;
BEGIN
  EXECUTE 'CREATE TEMP TABLE t_unmanaged_ddl_seed (id int)';
  EXECUTE 'INSERT INTO t_unmanaged_ddl_seed SELECT generate_series(1, 100)';
  PERFORM fasttrun_analyze('t_unmanaged_ddl_seed');

  EXECUTE 'CREATE TEMP TABLE t_unmanaged_index (id int, v int)';
  EXECUTE 'INSERT INTO t_unmanaged_index SELECT g, g FROM generate_series(1, 10000) g';
  EXECUTE 'ANALYZE t_unmanaged_index';
  EXECUTE 'CREATE INDEX ON t_unmanaged_index (id)';
  FOR ln IN EXECUTE 'EXPLAIN SELECT * FROM t_unmanaged_index WHERE v = 4242' LOOP
    IF ln ~ 'on t_unmanaged_index' THEN
      est := substring(ln FROM 'rows=(\d+)')::int;
      EXIT;
    END IF;
  END LOOP;
  SELECT count(*) INTO stat_count FROM pg_statistic
   WHERE starelid = 't_unmanaged_index'::regclass;
  IF est IS DISTINCT FROM 1 OR stat_count <> 2 THEN
    RAISE EXCEPTION 'CREATE INDEX hid core stats: est=%, rows=%', est, stat_count;
  END IF;

  EXECUTE 'CREATE TEMP TABLE t_unmanaged_alter (id int, v int)';
  EXECUTE 'INSERT INTO t_unmanaged_alter SELECT g, g FROM generate_series(1, 10000) g';
  EXECUTE 'ANALYZE t_unmanaged_alter';
  EXECUTE 'ALTER TABLE t_unmanaged_alter SET (autovacuum_enabled = false)';
  est := NULL;
  FOR ln IN EXECUTE 'EXPLAIN SELECT * FROM t_unmanaged_alter WHERE v = 4242' LOOP
    IF ln ~ 'on t_unmanaged_alter' THEN
      est := substring(ln FROM 'rows=(\d+)')::int;
      EXIT;
    END IF;
  END LOOP;
  SELECT count(*) INTO stat_count FROM pg_statistic
   WHERE starelid = 't_unmanaged_alter'::regclass;
  IF est IS DISTINCT FROM 1 OR stat_count <> 2 THEN
    RAISE EXCEPTION 'ALTER TABLE hid core stats: est=%, rows=%', est, stat_count;
  END IF;
END$$;
\echo unmanaged_ddl_keeps_core_stats
unmanaged_ddl_keeps_core_stats
DROP TABLE t_unmanaged_ddl_seed;
DROP TABLE t_unmanaged_index;
DROP TABLE t_unmanaged_alter;
-- ----------------------------------------------------------------------
-- 9. fasttruncate должен явно вытеснить кэш статистики по OID таблицы
--    (запасной механизм на случай, когда pgstat недоступен или
--    счётчики сброшены).
-- ----------------------------------------------------------------------
CREATE TEMP TABLE t_trunc_evict (id int);
INSERT INTO t_trunc_evict SELECT generate_series(1, 100000) g;
CREATE INDEX ON t_trunc_evict (id);
BEGIN;
SELECT fasttrun_collect_stats('t_trunc_evict');
 fasttrun_collect_stats 
------------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_trunc_evict WHERE id = 12345;
                         QUERY PLAN                          
-------------------------------------------------------------
 Index Only Scan using t_trunc_evict_id_idx on t_trunc_evict
   Index Cond: (id = 12345)
(2 rows)

SELECT fasttruncate('t_trunc_evict');
 fasttruncate 
--------------
 
(1 row)

INSERT INTO t_trunc_evict SELECT generate_series(1, 100) g;
EXPLAIN (COSTS OFF) SELECT * FROM t_trunc_evict WHERE id = 12345;
        QUERY PLAN         
---------------------------
 Seq Scan on t_trunc_evict
   Filter: (id = 12345)
(2 rows)

COMMIT;
DROP TABLE t_trunc_evict;
-- ----------------------------------------------------------------------
-- 10. Самостоятельный fasttrun_collect_stats (без fasttrun_analyze)
--     должен переживать COMMIT в рамках backend'а, если после сбора
--     не было DML.  Это ближе к обычному ANALYZE: план в следующей
--     транзакции не должен внезапно деградировать только из-за COMMIT.
-- ----------------------------------------------------------------------
CREATE TEMP TABLE t_leak (id int);
INSERT INTO t_leak SELECT generate_series(1, 100000) g;
CREATE INDEX ON t_leak (id);
BEGIN;
SELECT fasttrun_collect_stats('t_leak');
 fasttrun_collect_stats 
------------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_leak WHERE id = 12345;
                  QUERY PLAN                   
-----------------------------------------------
 Index Only Scan using t_leak_id_idx on t_leak
   Index Cond: (id = 12345)
(2 rows)

COMMIT;
EXPLAIN (COSTS OFF) SELECT * FROM t_leak WHERE id = 12345;
                  QUERY PLAN                   
-----------------------------------------------
 Index Only Scan using t_leak_id_idx on t_leak
   Index Cond: (id = 12345)
(2 rows)

DROP TABLE t_leak;
-- ----------------------------------------------------------------------
-- 11. Автоматический пересбор статистики при значимом DML.
--     Управляется порогом: если доля изменённых строк
--     (insert+update+delete с момента предыдущего сбора, делённая на
--     текущий reltuples) больше fasttrun.stats_refresh_threshold
--     (значение по умолчанию 0.2 = 20%), то очередной fasttrun_analyze
--     запускает пересбор статистики через полный reservoir sample.
--     Это дороже старой блочной выборки, зато совпадает с качеством
--     обычного ANALYZE на физически кластеризованных и sparse heap.
-- ----------------------------------------------------------------------
-- 11a. Значительный UPDATE (churn=1.0) → пересбор → план обновляется
CREATE TEMP TABLE t_refresh (id int, grp int);
INSERT INTO t_refresh SELECT g, g FROM generate_series(1, 100000) g;
CREATE INDEX ON t_refresh (grp);
BEGIN;
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
                   QUERY PLAN                    
-------------------------------------------------
 Index Scan using t_refresh_grp_idx on t_refresh
   Index Cond: (grp = 1)
(2 rows)

UPDATE t_refresh SET grp = 1;        -- доля изменений = 1.0 > 0.2 → пересбор
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
      QUERY PLAN       
-----------------------
 Seq Scan on t_refresh
   Filter: (grp = 1)
(2 rows)

COMMIT;
-- 11b. Маленький DELETE при пороге 0.2 — 0.009% ниже порога → пересбора
--      нет, но churn в пределах толерантности, поэтому soft freshness
--      отдаёт кешированную стату планировщику (как ядро PG между ANALYZE).
--      После 11a grp=1 — это все строки, так что план остаётся Seq Scan.
BEGIN;
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
      QUERY PLAN       
-----------------------
 Seq Scan on t_refresh
   Filter: (grp = 1)
(2 rows)

DELETE FROM t_refresh WHERE id < 10; -- 9 строк из 100000 = 0.009%
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
      QUERY PLAN       
-----------------------
 Seq Scan on t_refresh
   Filter: (grp = 1)
(2 rows)

COMMIT;
-- 11c. Порог = 0 принудительно запускает пересбор при любом DML
BEGIN;
SET LOCAL fasttrun.stats_refresh_threshold = 0;
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
      QUERY PLAN       
-----------------------
 Seq Scan on t_refresh
   Filter: (grp = 1)
(2 rows)

DELETE FROM t_refresh WHERE id < 20; -- даже 0.018% запускает пересбор
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
      QUERY PLAN       
-----------------------
 Seq Scan on t_refresh
   Filter: (grp = 1)
(2 rows)

COMMIT;
-- 11d. Порог = 1.0 отключает пересбор и задаёт максимальную толерантность:
--      стата прячется только когда churn достигает 100%.  Полный UPDATE
--      (100% строк) превышает порог → fallback к defaults.
BEGIN;
SET LOCAL fasttrun.stats_refresh_threshold = 1;
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
      QUERY PLAN       
-----------------------
 Seq Scan on t_refresh
   Filter: (grp = 1)
(2 rows)

UPDATE t_refresh SET grp = 999;     -- любой DML → пересбор отключён
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 999;
                  QUERY PLAN                  
----------------------------------------------
 Bitmap Heap Scan on t_refresh
   Recheck Cond: (grp = 999)
   ->  Bitmap Index Scan on t_refresh_grp_idx
         Index Cond: (grp = 999)
(4 rows)

COMMIT;
-- 11e. Below-threshold DML внутри savepoint.  После ROLLBACK TO SAVEPOINT
--      counters откатываются к pre-savepoint → стата точно свежая.  Без
--      rollback тот же below-threshold DML остаётся в пределах толерантности
--      → soft freshness продолжает отдавать кешированную стату планировщику.
BEGIN;
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

SAVEPOINT sp1;
DELETE FROM t_refresh WHERE id < 5;  -- ниже порога
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

ROLLBACK TO sp1;
-- После отката savepoint хук должен вернуть кешированную статистику
-- (counters откатились к pre-savepoint значениям, collected_* не
-- менялся внутри savepoint → match)
EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
                   QUERY PLAN                    
-------------------------------------------------
 Index Scan using t_refresh_grp_idx on t_refresh
   Index Cond: (grp = 1)
(2 rows)

-- Теперь тот же DML без savepoint — churn в пределах порога → стата видна
DELETE FROM t_refresh WHERE id < 5;
SELECT fasttrun_analyze('t_refresh');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_refresh WHERE grp = 1;
                   QUERY PLAN                    
-------------------------------------------------
 Index Scan using t_refresh_grp_idx on t_refresh
   Index Cond: (grp = 1)
(2 rows)

COMMIT;
-- 11f. DML ниже порога внутри savepoint с последующим RELEASE.  RELEASE
--      продвигает pgstat counters в родительский subxact; churn остаётся в
--      пределах толерантности, поэтому soft freshness отдаёт кешированную
--      стату.
--
--      High-cardinality таблица: редкий equality-предикат на кешированной
--      стате даёт Index Scan (на defaults был бы Bitmap).
CREATE TEMP TABLE t_release_stats (id int, grp int);
INSERT INTO t_release_stats SELECT g, g FROM generate_series(1, 100000) g;
CREATE INDEX ON t_release_stats (grp);
BEGIN;
SELECT fasttrun_analyze('t_release_stats');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_release_stats WHERE grp = 50000;
                         QUERY PLAN                          
-------------------------------------------------------------
 Index Scan using t_release_stats_grp_idx on t_release_stats
   Index Cond: (grp = 50000)
(2 rows)

SAVEPOINT sp_release;
DELETE FROM t_release_stats WHERE id < 10;  -- ниже порога
SELECT fasttrun_analyze('t_release_stats');
 fasttrun_analyze 
------------------
 
(1 row)

RELEASE SAVEPOINT sp_release;
-- Below-threshold churn → soft freshness держит стату → Index Scan.
EXPLAIN (COSTS OFF) SELECT * FROM t_release_stats WHERE grp = 50000;
                         QUERY PLAN                          
-------------------------------------------------------------
 Index Scan using t_release_stats_grp_idx on t_release_stats
   Index Cond: (grp = 50000)
(2 rows)

COMMIT;
DROP TABLE t_release_stats;
-- 11g. Targeted UPDATE концентрирует 10% строк на grp=1 — выше строгого порога
--      для high-cardinality колонки.  Cardinality-aware freshness прячет стату,
--      и planner уходит на defaults (Bitmap), а не строит Index Scan по
--      «редкому» grp=1, который на деле стал частым.  Защита сохраняется и
--      после COMMIT.
CREATE TEMP TABLE t_commit_stale_stats (id int, grp int);
INSERT INTO t_commit_stale_stats SELECT g, g FROM generate_series(1, 100000) g;
CREATE INDEX ON t_commit_stale_stats (grp);
BEGIN;
SELECT fasttrun_analyze('t_commit_stale_stats');
 fasttrun_analyze 
------------------
 
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM t_commit_stale_stats WHERE grp = 1;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Index Scan using t_commit_stale_stats_grp_idx on t_commit_stale_stats
   Index Cond: (grp = 1)
(2 rows)

UPDATE t_commit_stale_stats SET grp = 1 WHERE id <= 10000;  -- ниже порога 20%
SELECT fasttrun_analyze('t_commit_stale_stats');
 fasttrun_analyze 
------------------
 
(1 row)

-- Targeted churn выше строгого порога high-card → стата скрыта → defaults.
EXPLAIN (COSTS OFF) SELECT * FROM t_commit_stale_stats WHERE grp = 1;
                       QUERY PLAN                        
---------------------------------------------------------
 Bitmap Heap Scan on t_commit_stale_stats
   Recheck Cond: (grp = 1)
   ->  Bitmap Index Scan on t_commit_stale_stats_grp_idx
         Index Cond: (grp = 1)
(4 rows)

COMMIT;
-- После COMMIT защита сохраняется → план остаётся на defaults.
EXPLAIN (COSTS OFF) SELECT * FROM t_commit_stale_stats WHERE grp = 1;
                       QUERY PLAN                        
---------------------------------------------------------
 Bitmap Heap Scan on t_commit_stale_stats
   Recheck Cond: (grp = 1)
   ->  Bitmap Index Scan on t_commit_stale_stats_grp_idx
         Index Cond: (grp = 1)
(4 rows)

SELECT count(*) = 10000 AS commit_stale_actual_grp1
  FROM t_commit_stale_stats WHERE grp = 1;
 commit_stale_actual_grp1 
--------------------------
 t
(1 row)

DROP TABLE t_commit_stale_stats;
DROP TABLE t_refresh;
-- 11h. Cardinality-aware граница: для high-cardinality (unique) колонки порог
--      толерантности ужесточён (concentrated DML может раздуть «редкое»
--      значение в катастрофический Index Scan).  Мелкий churn ниже строгого
--      порога держит стату видимой (Index Scan), churn выше — прячет её.
CREATE TEMP TABLE t_skew_below (id int, grp int);
INSERT INTO t_skew_below SELECT g, g FROM generate_series(1, 100000) g;
CREATE INDEX ON t_skew_below (grp);
BEGIN;
SELECT fasttrun_analyze('t_skew_below');
 fasttrun_analyze 
------------------
 
(1 row)

DELETE FROM t_skew_below WHERE id <= 3000;    -- 3% ниже строгого high-card порога → видна
EXPLAIN (COSTS OFF) SELECT * FROM t_skew_below WHERE grp = 50000;
                      QUERY PLAN                       
-------------------------------------------------------
 Index Scan using t_skew_below_grp_idx on t_skew_below
   Index Cond: (grp = 50000)
(2 rows)

COMMIT;
DROP TABLE t_skew_below;
CREATE TEMP TABLE t_skew_above (id int, grp int);
INSERT INTO t_skew_above SELECT g, g FROM generate_series(1, 100000) g;
CREATE INDEX ON t_skew_above (grp);
BEGIN;
SELECT fasttrun_analyze('t_skew_above');
 fasttrun_analyze 
------------------
 
(1 row)

DELETE FROM t_skew_above WHERE id <= 10000;   -- 10% выше строгого high-card порога → прячется
EXPLAIN (COSTS OFF) SELECT * FROM t_skew_above WHERE grp = 50000;
                   QUERY PLAN                    
-------------------------------------------------
 Bitmap Heap Scan on t_skew_above
   Recheck Cond: (grp = 50000)
   ->  Bitmap Index Scan on t_skew_above_grp_idx
         Index Cond: (grp = 50000)
(4 rows)

COMMIT;
DROP TABLE t_skew_above;
