(1 row)

COMMIT;
BEGIN;
ANALYZE t_handoff;
ROLLBACK;
SELECT coalesce(array_agg(staattnum ORDER BY staattnum) =
                ARRAY[1, 2]::smallint[], false) AS handoff_top_rollback
  FROM fasttrun_inspect_stats('t_handoff');
