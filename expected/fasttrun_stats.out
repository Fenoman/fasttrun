CREATE TRIGGER t_seq_commit_trigger_bu BEFORE UPDATE ON t_seq_commit_trigger
  FOR EACH ROW EXECUTE FUNCTION t_seq_commit_trigger_fn();
BEGIN;
UPDATE t_seq_commit_trigger SET note = 'y';
