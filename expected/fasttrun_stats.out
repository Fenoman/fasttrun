(1 row)

SELECT fasttruncate('t_seed_truncate');
 fasttruncate 
--------------
 
(1 row)

INSERT INTO t_seed_truncate SELECT g, g FROM generate_series(1, 100) g;
SELECT fasttrun_analyze('t_seed_truncate');
