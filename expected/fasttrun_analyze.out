-- ----------------------------------------------------------------------
-- 21. Счетчики изменений переживают COMMIT.  При max_analyze_pages = 1
--     любой проход по таблице пишет DEBUG-строку о выборке блоков, так что
--     видно, где analyze сканировал.  Первый analyze новой транзакции без
--     DML не сканирует и не сбрасывает планы.  Строки, записанные в
--     транзакциях без вызовов fasttrun, учитываются, откаченные - нет.
--     Изменения ниже порога пересбора накапливаются через COMMIT, и
--     пересбор происходит, когда сумма его достигает.  У таблицы одна
--     колонка с 10 значениями, чтобы порог колонки совпадал с общим.
-- ----------------------------------------------------------------------
CREATE TEMP TABLE t_carry (grp int);
INSERT INTO t_carry SELECT g % 10 FROM generate_series(1, 10000) g;
SELECT fasttrun_analyze('t_carry');
 fasttrun_analyze 
------------------
 
(1 row)

