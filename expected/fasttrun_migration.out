-- ----------------------------------------------------------------------
-- 9. Пустая миграция до последней версии сохраняет OID функции.
-- ----------------------------------------------------------------------
DO $$
DECLARE
    cache_stats_oid oid := 'public.fasttrun_cache_stats()'::regprocedure;
    v_latest text;
BEGIN
    SELECT default_version INTO v_latest
      FROM pg_available_extensions WHERE name = 'fasttrun';
    EXECUTE format('ALTER EXTENSION fasttrun UPDATE TO %L', v_latest);
    IF 'public.fasttrun_cache_stats()'::regprocedure::oid <> cache_stats_oid THEN
        RAISE EXCEPTION 'fasttrun_cache_stats OID changed during patch upgrade';
    END IF;
END
$$;
SELECT extname, extversion = (SELECT default_version FROM pg_available_extensions
                              WHERE name = 'fasttrun') AS at_latest
  FROM pg_extension WHERE extname = 'fasttrun';
extname|at_latest
fasttrun|t
(1 row)
-- ----------------------------------------------------------------------
-- 10. Обновление дает тот же набор функций, что и чистая установка,
--     включая функции наблюдаемости 2.6.0 и проверки для повторного использования таблицы 2.7.0.
-- ----------------------------------------------------------------------
CREATE TEMP TABLE mig_upgraded_funcs AS
SELECT p.oid::regprocedure::text AS func
  FROM pg_proc p
  JOIN pg_depend d ON d.objid = p.oid AND d.deptype = 'e'
  JOIN pg_extension e ON e.oid = d.refobjid AND e.extname = 'fasttrun';
SELECT func FROM mig_upgraded_funcs
 WHERE func ~ '^fasttrun_(counters|counters_reset|cached_tables|blocked_tables|temp_is_ours|temp_same_cols)\('
 ORDER BY func COLLATE "C";
func
fasttrun_blocked_tables()
fasttrun_cached_tables()
fasttrun_counters()
fasttrun_counters_reset()
fasttrun_temp_is_ours(regclass)
fasttrun_temp_same_cols(regclass,regclass)
(6 rows)
-- Атрибуты функций 2.7.0 после обновления и после чистой установки совпадают.
SELECT p.proname, p.provolatile, p.proisstrict, p.proparallel,
       p.prorettype::regtype AS rettype, p.prosrc
  FROM pg_proc p
  JOIN pg_depend d ON d.objid = p.oid AND d.deptype = 'e'
  JOIN pg_extension e ON e.oid = d.refobjid AND e.extname = 'fasttrun'
 WHERE p.proname IN ('fasttrun_temp_is_ours', 'fasttrun_temp_same_cols')
 ORDER BY p.proname;
proname|provolatile|proisstrict|proparallel|rettype|prosrc
fasttrun_temp_is_ours|v|t|u|boolean|fasttrun_temp_is_ours
fasttrun_temp_same_cols|v|t|u|boolean|fasttrun_temp_same_cols
(2 rows)
DROP EXTENSION fasttrun;
SELECT to_regprocedure('public.fasttrun_cache_stats()') IS NULL
       AS cache_stats_removed_after_drop;
cache_stats_removed_after_drop
t
(1 row)
CREATE EXTENSION fasttrun;
SELECT p.proname, p.provolatile, p.proisstrict, p.proparallel,
       p.prorettype::regtype AS rettype, p.prosrc
  FROM pg_proc p
  JOIN pg_depend d ON d.objid = p.oid AND d.deptype = 'e'
  JOIN pg_extension e ON e.oid = d.refobjid AND e.extname = 'fasttrun'
 WHERE p.proname IN ('fasttrun_temp_is_ours', 'fasttrun_temp_same_cols')
 ORDER BY p.proname;
proname|provolatile|proisstrict|proparallel|rettype|prosrc
fasttrun_temp_is_ours|v|t|u|boolean|fasttrun_temp_is_ours
fasttrun_temp_same_cols|v|t|u|boolean|fasttrun_temp_same_cols
(2 rows)
SELECT count(*) AS functions_only_in_fresh_install
  FROM (SELECT p.oid::regprocedure::text AS func
          FROM pg_proc p
          JOIN pg_depend d ON d.objid = p.oid AND d.deptype = 'e'
          JOIN pg_extension e ON e.oid = d.refobjid AND e.extname = 'fasttrun'
        EXCEPT
        SELECT func FROM mig_upgraded_funcs) diff;
functions_only_in_fresh_install
0
(1 row)
SELECT count(*) AS functions_only_after_upgrade
  FROM (SELECT func FROM mig_upgraded_funcs
        EXCEPT
        SELECT p.oid::regprocedure::text
          FROM pg_proc p
          JOIN pg_depend d ON d.objid = p.oid AND d.deptype = 'e'
          JOIN pg_extension e ON e.oid = d.refobjid AND e.extname = 'fasttrun') diff;
functions_only_after_upgrade
